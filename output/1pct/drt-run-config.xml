        <!-- Placeholder fuel-cost proxies (no real PH vehicle-operating-cost data
             for this project): fuel only, excludes maintenance/depreciation/
             parking/insurance. Based on approx. PHP 100/L gasoline (Puerto Princesa/
             Palawan runs PHP 5 to 25/L above Metro Manila's approx. PHP 76 to 107/L
             range) and real-world (not manufacturer-ideal) city fuel efficiency:
             motorcycle approx. 40 km/L (underbones are manufacturer-rated 50 to 63
             km/L, derated for stop-and-go traffic), car approx. 10 km/L city driving
             (compacts/sedans range approx. 8.5 to 16.7 km/L in PH city-driving
             reviews). monetaryDistanceRate is PHP per meter, normally negative.
             Revisit with real data if available. -->
        <parameterset type="modeParams" >
            <param name="mode" value="motorcycle" />
            <param name="constant" value="0.0" />
            <param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
