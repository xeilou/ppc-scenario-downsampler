<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
<!-- Generated by downsample_pipeline.py, fraction=0.01, label=1pct, iterations=1.
     DRT modes: astoda, bmtoda, sptoda, bancao_bancao_toda, istoda, istoda2, gvtv, jtoda, kabiptoda, nnps, nobtoda, pastoda, rotonda, litoda, sjtoda, sl_toda, sm_city_toda, sm_toda, todat, westoda.
     Transit Bus capacity: 70 real seats -> 2 (fraction=0.01, floor=2).
     Transit Bus PCE: 2.8 (real/unscaled — network capacity is not downscaled, see below, so no pce adjustment is needed).
     Network flowCapacityFactor/storageCapacityFactor: fixed at 1.0 (network downscaling disabled — road capacity does not shrink with FRACTION).
     Network storage-capacity fix: permlanes x100 on 1055 artificial (bus-only) connector links, so storageCapacityFactor doesn't crush them to a 1-vehicle floor. Also on 56 real DRT terminal/depot links, so thin-terminal-data zones' idle fleets don't oversubscribe a single link's queue space.
     Fleet counts: astoda=2/235, bmtoda=2/235, sptoda=2/234, bancao_bancao_toda=4/377, istoda=2/160, istoda2=2/180, gvtv=2/180, jtoda=2/39, kabiptoda=2/182, nnps=2/182, nobtoda=2/182, pastoda=4/395, rotonda=3/269, litoda=2/27, sjtoda=4/436, sl_toda=2/174, sm_city_toda=9/858, sm_toda=3/348, todat=2/177, westoda=6/630. -->

    <module name="global">
        <param name="randomSeed" value="4711" />
        <param name="coordinateSystem" value="EPSG:32650" />
        <param name="numberOfThreads" value="4" />
    </module>

    <module name="network">
        <param name="inputNetworkFile" value="./network/ppc-network-transit-mapped.xml.gz" />
    </module>

    <module name="transit">
        <param name="useTransit" value="true" />
        <param name="usingTransitInMobsim" value="true" />
        <param name="routingAlgorithmType" value="SwissRailRaptor" />
        <param name="transitModes" value="pt" />
        <param name="transitScheduleFile" value="./pt/ppc-schedule-mapped.xml.gz" />
        <param name="vehiclesFile" value="./vehicles/ppc-vehicles.xml.gz" />
    </module>

    <!-- Required for DRT: defines simulation time window and which network
         modes actually get simulated. mainMode must include "car" since
         dvrp.networkModes = car (DRT vehicles route on car-mode links).
         endTime set past the 22:00 operating window with buffer, so trips
         still in progress near closing time aren't cut off mid-simulation. -->
    <module name="qsim">
        <param name="startTime" value="00:00:00" />
        <param name="endTime" value="24:00:00" />
        <param name="simEndtimeInterpretation" value="onlyUseEndtime" />
        <param name="mainMode" value="car" />
        <!-- Required by DRT's dynamic agents (DVRP) — without this, the
             controller refuses to start with a consistency error. -->
        <param name="simStarttimeInterpretation" value="onlyUseStarttime" />
        <!-- Downsampled to match the 10% population sample (plans-10pct.xml.gz) -->
        <param name="flowCapacityFactor" value="1.0" />
        <param name="storageCapacityFactor" value="1.0" />
    </module>

    <module name="plans">
        <param name="inputPlansFile" value="./plans/plans.xml.gz" />
    </module>

    <!-- The synthetic population's legs use pt/motorcycle/bike/car/walk.
         Only "car" and the drt_* modes are network-routed here for DRT
         vehicles; pt is now schedule-based via the transit module above
         (SwissRailRaptor), not teleported. motorcycle and bike must still
         be registered as teleported modes or the sim rejects the
         population outright on an "unregistered main mode" error before
         DRT ever gets a chance to run. motorcycle is the dominant mode
         (the pre-DRT tricycle proxy), so this isn't optional.
         Speeds are rough placeholders, not measured. -->
    <module name="routing">
        <parameterset type="teleportedModeParameters">
            <param name="mode" value="walk" />
            <param name="teleportedModeSpeed" value="1.1" />
            <param name="beelineDistanceFactor" value="1.3" />
        </parameterset>
        <parameterset type="teleportedModeParameters">
            <param name="mode" value="motorcycle" />
            <param name="teleportedModeSpeed" value="8.0" />
            <param name="beelineDistanceFactor" value="1.3" />
        </parameterset>
        <parameterset type="teleportedModeParameters">
            <param name="mode" value="bike" />
            <param name="teleportedModeSpeed" value="3.75" />
            <param name="beelineDistanceFactor" value="1.3" />
        </parameterset>
    </module>

